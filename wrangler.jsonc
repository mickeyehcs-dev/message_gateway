{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "universal-notification-gateway",
  "main": "src/index.js",
  "compatibility_date": "2026-10-26",
  "workers_dev": true,
  "vars": {
    "EMAIL_API_URL": "https://sender-api.mickey.qzz.io/api/v1/send",
    "EMAIL_SENDER_ID": "REPLACE_WITH_DEFAULT_SENDER_ID"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "universal-notification-gateway",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}
