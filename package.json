{
  "name": "universal-notification-gateway",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply message_gateway --local",
    "db:migrate:remote": "wrangler d1 migrations apply message_gateway --remote",
    "admin:create": "node scripts/create-admin.mjs",
    "admin:reset": "node scripts/reset-password.mjs"
  },
  "devDependencies": {
    "vitest": "^5.0.5",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0"
  }
}
